{
  "name": "ai-video-cataloger",
  "version": "1.0.0",
  "description": "CLI tool and Electron GUI that analyzes videos, transcribes with local Whisper, generates summaries via Claude/LLaVA, and renames files based on content",
  "type": "module",
  "main": "electron/dist/main/index.js",
  "bin": {
    "ai-video-cataloger": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p electron/tsconfig.renderer.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "electron:dev": "concurrently \"npm run electron:vite\" \"npm run electron:main-dev\"",
    "electron:vite": "vite --config electron/vite.config.ts",
    "electron:main-dev": "NODE_ENV=development electron electron/dist/main/index.js",
    "electron:build": "npm run electron:build-main && npm run electron:build-renderer",
    "electron:build-main": "tsc -p electron/tsconfig.json",
    "electron:build-renderer": "vite build --config electron/vite.config.ts",
    "electron:package": "npm run electron:build && electron-builder --config electron-builder.config.js"
  },
  "keywords": [
    "video",
    "transcription",
    "ai",
    "cataloger",
    "whisper",
    "claude",
    "llava",
    "electron"
  ],
  "author": "",
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@inquirer/prompts": "^8.2.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "electron-store": "^10.0.0",
    "execa": "^9.5.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "openai": "^6.16.0",
    "ora": "^8.1.1",
    "slugify": "^1.6.6",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
