{
  "name": "ai-video-cataloger",
  "version": "1.0.0",
  "description": "CLI tool that analyzes videos, transcribes with local Whisper, generates summaries via Claude/LLaVA, and renames files based on content",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "bin": {
    "ai-video-cataloger": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --project electron/main/tsconfig.json --noEmit && tsc --project electron/preload/tsconfig.json --noEmit && tsc --project electron/renderer/tsconfig.json --noEmit && npm run lint",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "electron:dev": "concurrently \"npm run electron:dev:vite\" \"npm run electron:dev:electron\"",
    "electron:dev:vite": "cd electron/renderer && vite",
    "electron:dev:electron": "tsc --project electron/main/tsconfig.json && tsc --project electron/preload/tsconfig.json && cp electron/preload/package.json dist-electron/preload/ && NODE_ENV=development electron .",
    "electron:build": "npm run electron:build:renderer && npm run electron:build:main && npm run electron:build:preload",
    "electron:build:main": "tsc --project electron/main/tsconfig.json",
    "electron:build:preload": "tsc --project electron/preload/tsconfig.json && cp electron/preload/package.json dist-electron/preload/",
    "electron:build:renderer": "cd electron/renderer && vite build",
    "electron:package": "npm run electron:build && electron-builder --config electron-builder.config.js",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:renderer": "vitest run --config electron/renderer/vitest.config.ts",
    "test:e2e": "npm run build && npx tsx test/ai-integration-test.ts"
  },
  "keywords": [
    "video",
    "transcription",
    "ai",
    "cataloger",
    "whisper",
    "claude",
    "llava"
  ],
  "author": "",
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@inquirer/prompts": "^8.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-virtual": "^3.14.2",
    "autoprefixer": "^10.4.24",
    "chalk": "^5.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "execa": "^9.5.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.574.0",
    "openai": "^6.16.0",
    "ora": "^8.1.1",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "slugify": "^1.6.6",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
