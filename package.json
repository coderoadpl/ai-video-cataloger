{
  "name": "ai-video-cataloger",
  "version": "0.5.10",
  "private": true,
  "type": "module",
  "description": "Local-first Electron + CLI video cataloger on the agentproofarch foundation",
  "main": "dist-electron/main.js",
  "bin": {
    "ai-video-cataloger": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:islands": "tsc --noEmit -p tsconfig.islands.json",
    "lint": "eslint .",
    "depcruise": "depcruise core adapters apps scripts/smoke.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "doc-lint": "node --import tsx scripts/doc-lint.ts",
    "check": "npm run typecheck && npm run typecheck:islands && npm run lint && npm run depcruise && npm run knip && npm run doc-lint && npm run test:coverage",
    "cli": "tsx apps/cli/src/main.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "electron:build:renderer": "vite build --config apps/web/vite.config.ts",
    "electron:build:desktop": "node scripts/build-electron.mjs",
    "package:stage": "node scripts/build-packaged-cli.mjs",
    "electron:build": "npm run electron:build:renderer && npm run electron:build:desktop && npm run package:stage",
    "test:e2e:cli": "npm run package:stage && playwright test --config test/e2e/playwright.config.ts --project=cli",
    "test:e2e:gui": "npm run electron:build && playwright test --config test/e2e/playwright.config.ts --project=gui",
    "test:e2e:parity": "npm run electron:build && playwright test --config test/e2e/playwright.config.ts --project=cli --project=gui",
    "test:e2e:matrix": "npm run electron:build && playwright test --config test/e2e/playwright.config.ts --project=matrix",
    "electron:dev": "npm run electron:build:desktop && sh -c 'NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:9473 vite --config apps/web/vite.config.ts --host 127.0.0.1 & vite_pid=$!; NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:9473 electron .; status=$?; kill $vite_pid; exit $status'",
    "electron:package": "npm run electron:build && electron-builder --config electron-builder.config.js",
    "verify:package": "node scripts/verify-package.mjs",
    "lock-lint": "npx -y npm@10 ls --all --package-lock-only >/dev/null"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@mui/material": "^9.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@tanstack/query-core": "^5.83.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.130.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/sql.js": "^1.4.11",
    "commander": "^14.0.0",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "^4.8.5",
    "onnxruntime-node": "1.27.0",
    "openai": "^6.46.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.61.1",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^16.10.3",
    "electron": "^37.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "eslint": "^9.31.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "knip": "^6.0.0",
    "msw": "^2.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
