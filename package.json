    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "^4.8.5",
    "openai": "^6.46.0",
    "sql.js": "^1.14.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.14",
    "dependency-cruiser": "^16.10.3",
    "eslint": "^9.31.0",
